<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#14251B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMART COOKING"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="#B7D99A"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What's cooking?"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Discover meals you can make with ingredients in your pantry."
            android:textSize="15sp"
            android:textColor="#C3CEC5"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnFindRecipes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Find Recipes"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#14251B"
            android:backgroundTint="#B7D99A" />

        <TextView
            android:id="@+id/txtRecipeResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap Find Recipes to discover meals."
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:lineSpacingExtra="6dp"
            android:padding="18dp"
            android:layout_marginTop="20dp"
            android:background="#20382A" />

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Back to Home"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2C4937"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>
