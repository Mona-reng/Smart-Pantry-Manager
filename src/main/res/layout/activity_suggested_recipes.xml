<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F7F2">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suggested Recipes"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#24452C"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Discover meals you can make with ingredients in your pantry."
        android:textSize="16sp"
        android:textColor="#555555"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/btnFindRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Find Recipes" />

    <TextView
        android:id="@+id/txtRecipeResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap Find Recipes to discover meals."
        android:textSize="16sp"
        android:textColor="#24452C"
        android:paddingTop="16dp" />

    <Button
        android:id="@+id/btnBackHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Home"
        android:layout_marginTop="16dp" />

</LinearLayout>
