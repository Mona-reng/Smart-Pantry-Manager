<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#14251B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADD TO YOUR PANTRY"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="#B7D99A"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fresh ingredients."
            android:textSize="29sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep track of what you have and when it expires."
            android:textSize="14sp"
            android:textColor="#C3CEC5"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredient name"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtIngredientName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="e.g. Tomatoes"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAB8AC"
            android:backgroundTint="#B7D99A"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quantity"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtIngredientQuantity"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="e.g. 3"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAB8AC"
            android:backgroundTint="#B7D99A"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unit"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtIngredientUnit"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="e.g. pieces, kg, litres"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAB8AC"
            android:backgroundTint="#B7D99A"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expiry date (optional)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtIngredientExpiry"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="e.g. 2026-11-30"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAB8AC"
            android:backgroundTint="#B7D99A"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSaveIngredient"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Ingredient"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#14251B"
            android:backgroundTint="#B7D99A" />

    </LinearLayout>
</ScrollView>
